NODE_ENV=development
PORT=4000

# Postgres connection used by Drizzle. Point this at your Supabase
# project's connection string (Project Settings -> Database -> Connection
# string -> URI), or a local Postgres instance during development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labarc

# Supabase project — optional. Leave blank until auth/storage are wired
# up in a later phase; the app boots fine without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Auth — generate strong random values, e.g. `openssl rand -hex 32`.
# The scaffold script auto-generates these into server/.env for you.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Optional: seeds a platform super admin + first organization when you run
# `pnpm run db:seed`. Leave blank to skip.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_ORG_NAME=
SEED_ORG_SLUG=
